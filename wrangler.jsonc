{
  "name": "alyzia-ops-v2",
  "main": "./src/v2-ui-consistency-wrapper.js",
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "ALYZIA_AUTOPILOT_ENABLED": "false",
    "ALYZIA_LIVE_APIS_ENABLED": "false",
    "ALYZIA_V2_MODE": "true",
    "ALYZIA_V2_TEST_CARRIERS": "TK"
  },

  "services": [
    {
      "binding": "SARIA",
      "service": "saria-seatmap"
    }
  ],

  // V2 MUST NOT point to the V1 production database.
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "alyzia-ops-v2-db",
      "database_id": "40c548c3-2374-46b0-892f-dfc342a2303d"
    }
  ],

  // Separate V2 bucket: never reuse alyzia-ops-files from V1.
  "r2_buckets": [
    {
      "binding": "OPS_FILES",
      "bucket_name": "alyzia-ops-v2-files"
    }
  ]
}
