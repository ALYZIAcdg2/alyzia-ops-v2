{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alyzia-ops-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alyzia-ops-db",
      "database_id": "2881327d-f2dd-4037-a395-f7095b32c69c",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }

  // Futur lot R2 : ajouter ici un binding r2_buckets après création du bucket.
  // Futur lot Queues : ajouter ici producteurs/consommateurs après création des queues.
}
